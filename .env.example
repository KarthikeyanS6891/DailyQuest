# Leave DATABASE_URL unset to use the in-memory store (good for first run).
# For local Docker Postgres (see docker-compose.yml), use:
# DATABASE_URL=postgres://dailyquest:dailyquest@localhost:5432/dailyquest
#
# For hosted Postgres (Neon / Supabase / Railway), paste their connection string.
# DATABASE_URL=postgres://user:pass@host:5432/dailyquest

# 32+ char random string used to sign session cookies. Generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
AUTH_SECRET=replace-me-with-a-32-char-random-string-for-real

# Optional: Google OAuth ("Continue with Google" button).
# Both must be set or the button is hidden and the API routes return 501.
# Create credentials at https://console.cloud.google.com/apis/credentials
# and register these Authorized redirect URIs on the OAuth client:
#   http://localhost:3456/api/auth/google/callback   (local dev)
#   https://<your-app>.up.railway.app/api/auth/google/callback   (prod)
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=
