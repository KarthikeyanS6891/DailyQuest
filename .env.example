# Leave DATABASE_URL unset to use the in-memory store (good for first run).
# When ready, point this at a Postgres instance (Neon, Supabase, local docker).
# DATABASE_URL=postgres://user:pass@host:5432/dailyquest

# Single-user dev mode. Auth comes in a later phase (Clerk or Auth.js).
DEV_USER_ID=dev-user
